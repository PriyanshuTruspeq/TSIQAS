<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
>
    <Dialog
        id="validationErrorsDialog"
        title="Validation Errors ({= ${validation>/totalErrors} || 0 })"
        titleAlignment="Center"
        state="Error"
        icon="sap-icon://message-error"
        contentWidth="700px"
        contentHeight="500px"
    >
        <content>
            <VBox
                id="_IDGenVBox5"
                class="sapUiMediumMargin"
            >
                <!-- Simple Summary -->
                <Panel
                    id="_IDGenPanel"
                    headerText="Error Summary"
                    expandable="false"
                    class="sapUiSmallMarginBottom"
                >
                    <HBox
                        id="_IDGenHBox2"
                        justifyContent="SpaceBetween"
                        alignItems="Center"
                        class="sapUiMediumMargin"
                    >
                        <ObjectNumber
                            id="_IDGenObjectNumber3"
                            number="{= ${validation>/flatErrors}.length || 0}"
                            unit="Total Errors"
                            state="Error"
                        />
                        <ObjectNumber
                            id="_IDGenObjectNumber4"
                            number="{= ${validation>/affectedAssets} || 0}"
                            unit="Affected Assets"
                            state="Error"
                        />
                    </HBox>
                </Panel>

                <!-- Simple message -->
                <MessageStrip
                    id="_IDGenMessageStrip"
                    text="Please fix the following errors before submitting changes to SAP."
                    type="Error"
                    showIcon="true"
                    class="sapUiSmallMarginBottom"
                />

                <!-- Simple filter toolbar -->
                <Toolbar
                    id="_IDGenToolbar"
                    class="sapUiSmallMarginBottom"
                >
                    <Title
                        id="_IDGenTitle3"
                        text="Filter by Asset:"
                    />
                    <ToolbarSpacer id="_IDGenToolbarSpacer2" />
                    <ComboBox
                        id="_IDGenComboBox"
                        width="150px"
                        placeholder="All Assets"
                        selectedKey="{validationFilter>/asset}"
                        selectionChange=".onValidationFilterChange"
                    >
                        <core:Item
                            id="_IDGenItem1"
                            key=""
                            text="All Assets"
                        />
                    </ComboBox>
                    <Button
                        id="_IDGenButton3"
                        icon="sap-icon://clear-filter"
                        tooltip="Clear Filter"
                        press=".onClearValidationFilters"
                        type="Transparent"
                    />
                </Toolbar>

                <!-- Simplified errors table -->
                <Table
                    id="_IDGenTable"
                    items="{
                        path: 'validation>/flatErrors',
                        filters: [
                            {
                                path: 'asset',
                                operator: 'Contains',
                                value1: '{validationFilter>/asset}'
                            }
                        ]
                    }"
                    mode="None"
                    growing="true"
                    growingThreshold="20"
                    alternateRowColors="true"
                >
                    <columns>
                        <Column
                            id="_IDGenColumn1"
                            width="15%"
                            hAlign="Begin"
                        >
                            <Text
                                id="_IDGenText8"
                                text="Asset"
                            />
                        </Column>
                        <Column
                            id="_IDGenColumn2"
                            width="10%"
                            hAlign="Center"
                        >
                            <Text
                                id="_IDGenText9"
                                text="Sequence"
                            />
                        </Column>
                        <Column
                            id="_IDGenColumn3"
                            width="20%"
                            hAlign="Begin"
                        >
                            <Text
                                id="_IDGenText10"
                                text="Field"
                            />
                        </Column>
                        <Column
                            id="_IDGenColumn4"
                            width="55%"
                            hAlign="Begin"
                        >
                            <Text
                                id="_IDGenText11"
                                text="Error Message"
                            />
                        </Column>
                    </columns>
                    <items>
                        <ColumnListItem
                            id="_IDGenColumnListItem"
                            type="Inactive"
                        >
                            <cells>
                                <Text
                                    id="_IDGenText12"
                                    text="{validation>asset}"
                                    wrapping="false"
                                />
                                <Text
                                    id="_IDGenText13"
                                    text="{validation>sequenceId}"
                                />
                                <Text
                                    id="_IDGenText14"
                                    text="{= ${validation>field} || 'General'}"
                                    wrapping="false"
                                />
                                <Text
                                    id="_IDGenText15"
                                    text="{validation>message}"
                                    wrapping="true"
                                />
                            </cells>
                        </ColumnListItem>
                    </items>
                    <noData>
                        <MessageStrip
                            id="_IDGenMessageStrip3"
                            text="No validation errors found."
                            type="Success"
                            showIcon="true"
                        />
                    </noData>
                </Table>
            </VBox>
        </content>
        <beginButton>
            <Button
                id="_IDGenButton11"
                text="Close"
                press=".onValidationDialogClose"
            />
        </beginButton>
        <endButton>
            <Button
                id="_IDGenButton17"
                text="Export Errors"
                icon="sap-icon://excel-attachment"
                press=".onExportValidationErrors"
                type="Emphasized"
            />
        </endButton>
    </Dialog>
</core:FragmentDefinition>
